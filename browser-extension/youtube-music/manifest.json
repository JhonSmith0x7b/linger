{
  "manifest_version": 3,
  "name": "Linger · YouTube Music",
  "description": "让 Linger 控制指定的 YouTube Music 标签页，不切换窗口焦点。",
  "version": "0.1.1",
  "minimum_chrome_version": "120",
  "permissions": ["scripting", "storage", "alarms"],
  "host_permissions": ["https://music.youtube.com/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "worker.js", "type": "module"},
  "action": {"default_popup": "panel.html"}
}
